# postgres://user:pass@localhost:5432/undangan  OR  pglite://./.data/dev (embedded, dev only)
DATABASE_URL=pglite://./.data/dev

# Dev-only password for the seeded dev@example.test account (ignored if the account already has a password).
# Required in production when seeding.
SEED_DEV_PASSWORD=

# Local plain-http only (e2e). Never set in production: disables the Secure cookie flag.
# AUTH_INSECURE_COOKIES=1

# PGlite is refused in production unless explicitly allowed (e2e/CI only).
# ALLOW_PGLITE_IN_PRODUCTION=1
